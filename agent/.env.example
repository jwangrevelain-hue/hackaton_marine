# Copier ce fichier en `.env` et renseigner la clef API Mistral
# Obtenir une clef : https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=votre_clef_ici

# Modèle à utiliser (défaut : mistral-large-latest)
# Alternatives : mistral-small-latest, open-mixtral-8x22b, mistral-medium-latest
MISTRAL_MODEL=mistral-large-latest
